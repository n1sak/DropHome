# Copy to .env (or export these) before `npm start`. All optional.

# Port the API (and the built client) is served on.
PORT=8787

# Where uploaded files and the JSON database live.
DATA_DIR=./data

# Set this to let the house sort with Claude. Without it, the client falls back to its built-in rules.
ANTHROPIC_API_KEY=

# Any current Claude model id. A small, fast model is plenty for sorting.
ANTHROPIC_MODEL=claude-haiku-4-5

# Largest single upload, in megabytes.
MAX_UPLOAD_MB=250
